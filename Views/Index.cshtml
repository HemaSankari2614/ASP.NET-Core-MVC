@model List<ASP.NETCoreMVC.Models.Student>

@{
    ViewData["Title"] = "Home";
}

<h1>@ViewData["Title"]</h1>

<h3>@ViewBag.Message</h3>

@if (TempData["Message"] != null)
{
    <div class="alert alert-success">
        @TempData["Message"]
    </div>
}

<a asp-controller="Home"
   asp-action="Register"
   class="btn btn-primary">
    Register Student
</a>

<hr />

<h3>Student List</h3>

<table class="table table-bordered">
    <thead>
        <tr>
            <th>ID</th>
            <th>Name</th>
            <th>Email</th>
            <th>Age</th>
            <th>Department</th>
        </tr>
    </thead>

    <tbody>
        @foreach (var student in Model)
        {
            <tr>
                <td>@student.Id</td>
                <td>@student.Name</td>
                <td>@student.Email</td>
                <td>@student.Age</td>
                <td>@student.Department</td>
            </tr>
        }
    </tbody>
</table>
